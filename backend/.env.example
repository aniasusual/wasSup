# Database
DATABASE_URL=postgresql://logsuser:YOUR_DB_PASSWORD@localhost:5432/logsdb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=100

# MinIO (S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=YOUR_MINIO_PASSWORD
S3_BUCKET_NAME=logs-storage
S3_ARCHIVE_BUCKET=logs-archive
S3_REGION=us-east-1

# Security
SECRET_KEY=dev-secret-key-change-in-production-$(openssl rand -hex 32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=LogAnalysisBot
DEBUG=True

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# OpenAI (for later)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
